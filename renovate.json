{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["security:only-security-updates", "security:gomodIndirectSecurityUpdates"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchJsonata": ["$exists(isVulnerabilityAlert) and isVulnerabilityAlert = true and vulnerabilitySeverity = 'LOW'"],
      "enabled": false
    }
  ]
}
