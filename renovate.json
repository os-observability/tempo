{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Enables only medium and higher severity vulnerability PRs. This extends the global Mintmaker config at https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json",
  "extends": ["security:only-security-updates", "security:gomodIndirectSecurityUpdates"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "enabledManagers": ["gomod"],
  "gomod": {
    "packageRules": [
      {
        "description": "Disable non-security updates after MintMaker's manager rules",
        "matchJsonata": [
          "$exists(updateType) and $not(isVulnerabilityAlert = true)"
        ],
        "enabled": false
      },
      {
        "description": "Exclude LOW-severity security updates",
        "matchJsonata": [
          "isVulnerabilityAlert = true and vulnerabilitySeverity = 'LOW'"
        ],
        "force": {
          "enabled": false
        }
      }
    ]
  }
}
