{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["security:only-security-updates"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchJsonata": ["$exists(isVulnerabilityAlert) and isVulnerabilityAlert = true and vulnerabilitySeverity = 'LOW'"],
      "enabled": false
    }
  ],
  "gomod": {
    "packageRules": [
      {
        "matchManagers": ["gomod"],
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  }
}
